{
  "name": "opening-trainer",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/app/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:pwa": "tsc --noEmit && cross-env VITE_PWA_MODE=true vite build --mode pwa",
    "preview:pwa": "vite preview --mode pwa --host 0.0.0.0",
    "pwa:assets": "pwa-assets-generator",
    "desktop:prepare": "node scripts/build-desktop.mjs",
    "desktop:build": "npm run build && npm run desktop:prepare && electron-builder --config electron-builder.yml --win portable --x64",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:annotation-ui": "node scripts/smoke-annotation-ui.cjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mliebelt/pgn-parser": "^1.4.19",
    "chess.js": "^1.4.0",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.1.1",
    "stockfish": "^18.0.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^5.0.2",
    "cross-env": "^10.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
